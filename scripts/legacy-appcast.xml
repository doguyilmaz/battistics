<?xml version="1.0" encoding="utf-8"?>
<!--
  Frozen feed for builds up to 1.0.2, which carry the old bundle identifier
  com.dogukyilmaz.Battistics.

  Sparkle refuses to install an update whose bundle identifier differs from
  the running app's (Autoupdate/AppInstaller.m compares the two and fails),
  so those builds cannot be updated in place at all. An item with no
  <enclosure> is an informational update: Sparkle shows the notice and sends
  the user to <link> instead of downloading anything.

  Attach this file as appcast.xml on every release. Old copies poll
  releases/latest/download/appcast.xml, so it has to keep resolving. Newer
  builds read appcast-2.xml and never see this. Nothing here needs changing
  again — the link points at whatever the latest release is.
-->
<rss version="2.0" xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle">
  <channel>
    <title>Battistics</title>
    <link>https://github.com/doguyilmaz/battistics</link>
    <description>Battery statistics for the Mac.</description>
    <language>en</language>
    <item>
      <title>Battistics 1.1.0 — one manual update needed</title>
      <link>https://github.com/doguyilmaz/battistics/releases/latest</link>
      <sparkle:version>1.1.0</sparkle:version>
      <sparkle:shortVersionString>1.1.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
      <description><![CDATA[
        <h2>Download this one by hand</h2>
        <p>Battistics 1.1.0 corrects a misspelling in the app's internal
        identifier. macOS treats the result as a different app, so this
        version cannot install itself over the one you are running.</p>
        <p>Click <b>Download</b>, then drag the new Battistics to your
        Applications folder, replacing the old one. Your charge and health
        history is kept. Menu bar and notification settings reset to their
        defaults, and macOS asks about notifications once more.</p>
        <p>Automatic updates resume normally afterwards.</p>
      ]]></description>
    </item>
  </channel>
</rss>
