    "When Keep Awake ends, the Mac’s battery runs low or will not last the session, the lid closes away from Hotspot, or the Mac stops answering.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When Keep Awake ends, the Mac’s battery runs low or will not last the session, the lid closes away from Hotspot, or the Mac stops answering."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyanık Tut bittiğinde, Mac’in pili azaldığında ya da oturuma yetmeyecekse, Hotspot dışında kapak kapandığında veya Mac yanıt vermeyi bıraktığında."
          }
        }
      }
    },
    "Wi‑Fi drops once the Mac leaves its range in a bag, and so does remote control. Personal Hotspot keeps it online.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi‑Fi drops once the Mac leaves its range in a bag, and so does remote control. Personal Hotspot keeps it online."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac çantada Wi‑Fi menzilinden çıkınca bağlantı ve uzaktan kontrol kopar. Kişisel Erişim Noktası onu çevrimiçi tutar."
          }
        }
      }
    },
