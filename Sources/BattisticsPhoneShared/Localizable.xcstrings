          }
        }
      }
    },
    "It reports once Battistics is running and iPhone access is on. After that it keeps reporting while awake, also with the lid closed during Keep Awake.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It reports once Battistics is running and iPhone access is on. After that it keeps reporting while awake, also with the lid closed during Keep Awake."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Battistics açık ve iPhone erişimi açıkken bildirmeye başlar. Sonra uyanık olduğu sürece, Uyanık Tut sırasında kapak kapalıyken de bildirmeye devam eder."
          }
        }
      }
    },
