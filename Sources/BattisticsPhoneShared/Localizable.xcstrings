    "iOS sandboxes raw cycle and health counters from third-party apps. Enter the values shown in iOS Settings › Battery › Battery Health so Battistics can calculate your exact mAh and Wh capacity.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS sandboxes raw cycle and health counters from third-party apps. Enter the values shown in iOS Settings › Battery › Battery Health so Battistics can calculate your exact mAh and Wh capacity."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS, döngü ve sağlık sayaçlarını diğer uygulamalara göstermez. Battistics'in mAh ve Wh kapasiteni hesaplayabilmesi için Ayarlar › Pil › Pil Sağlığı'ndaki değerleri gir."
          }
        }
      }
    },
