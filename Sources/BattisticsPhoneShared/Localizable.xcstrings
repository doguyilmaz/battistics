    "If you put your Mac in a bag and leave Wi‑Fi range, internet and remote control will drop unless you use Personal Hotspot or a mobile router.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you put your Mac in a bag and leave Wi‑Fi range, internet and remote control will drop unless you use Personal Hotspot or a mobile router."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac’i çantaya koyup Wi‑Fi menzilinden çıkarsanız, Kişisel Erişim Noktası veya taşınabilir modem kullanmadığınız sürece internet ve uzaktan kontrol kopar."
          }
        }
      }
    },
