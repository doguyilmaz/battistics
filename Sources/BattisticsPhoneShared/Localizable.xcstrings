    "A Mac must be awake with Battistics open at least once to broadcast its initial state to iCloud. Once connected, Keep Awake works even with the lid closed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Mac must be awake with Battistics open at least once to broadcast its initial state to iCloud. Once connected, Keep Awake works even with the lid closed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'in ilk durumunu iCloud'a yazması için en az bir kez uyanık ve Battistics açık olmalı. Bağlandıktan sonra Uyanık Tut kapak kapalıyken de çalışır."
          }
        }
      }
    },
    "A full-width Lock Screen widget with charge bar, power, health, cycles and the Keep Awake timer.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A full-width Lock Screen widget with charge bar, power, health, cycles and the Keep Awake timer."
          }
