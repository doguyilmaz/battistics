    "Turn on Personal Hotspot before the Mac goes in a bag, so its tasks stay online.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac çantaya girmeden Kişisel Erişim Noktası’nı aç ki görevleri çevrimiçi kalsın."
          }
        }
      }
    },
    "Turn this on to end Keep Awake at a battery level you choose. It allows normal sleep; it does not shut down the Mac. Low-battery warnings below are on by default.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn this on to end Keep Awake at a battery level you choose. It allows normal sleep; it does not shut down the Mac. Low-battery warnings below are on by default."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyanık Tut’u seçtiğiniz pil seviyesinde bitirmek için bunu açın. Mac’i kapatmaz; normal uykuya izin verir. Aşağıdaki düşük pil uyarıları varsayılan olarak açıktır."
          }
        }
      }
    },
    "Understand changes over time": {
      "extractionState": "manual",
