    "A prefilled issue or email opens for you to describe what happened. Battistics adds only these lines, and nothing is sent until you send it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A prefilled issue or email opens for you to describe what happened. Battistics adds only these lines, and nothing is sent until you send it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne olduğunu anlatmanız için önceden doldurulmuş bir issue veya e-posta açılır. Battistics yalnızca bu satırları ekler ve siz göndermeden hiçbir şey gönderilmez."
          }
        }
      }
    },
    "AI Focus": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Focus"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Odak"
          }
        }
      }
    },
    "AI Focus, Long Build, Overnight and Presentation combine a mode with a time limit. They keep your protection settings. AI Focus is a timer; it does not detect when an AI task finishes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Focus, Long Build, Overnight and Presentation combine a mode with a time limit. They keep your protection settings. AI Focus is a timer; it does not detect when an AI task finishes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Odak, Uzun Derleme, Gece Boyu ve Sunum bir modu süre sınırıyla birleştirir. Koruma ayarlarınız korunur. AI Odak süreli bir oturumdur; yapay zekâ görevinin bittiğini algılamaz."
          }
        }
      }
    },
    "AI clients": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapay zekâ istemcileri"
          }
        }
      }
    },
    "AI selected this answer from the built-in guide on this Mac. Check the source if it does not answer your question.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI bu yanıtı Mac’inizdeki hazır rehberden seçti. Sorunuzu karşılamıyorsa kaynak yazıyı kontrol edin."
          }
        }
      }
    },
