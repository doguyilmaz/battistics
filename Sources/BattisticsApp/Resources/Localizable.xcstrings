          }
        }
      }
    },
    "Recording": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt"
          }
        }
      }
    },
    "Charge history is event driven and costs nothing while idle. Power and temperature history need one lightweight reading on a timer.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şarj geçmişi olay tabanlıdır ve boştayken hiçbir maliyeti yoktur. Güç ve sıcaklık geçmişi ise zamanlayıcıyla tek bir hafif okuma gerektirir."
          }
        }
      }
    },
    "Record power and temperature": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güç ve sıcaklığı kaydet"
          }
        }
      }
    },
    "Sampling interval": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Örnekleme aralığı"
          }
        }
      }
    },
    "30 seconds": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "30 saniye"
          }
        }
      }
    },
    "1 minute": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 dakika"
          }
        }
      }
    },
    "2 minutes": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "2 dakika"
          }
        }
      }
    },
    "5 minutes": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "5 dakika"
          }
        }
      }
    },
    "Data": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veri"
          }
        }
      }
    },
    "On disk": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diskte"
          }
        }
      }
    },
    "Export CSV…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV Dışa Aktar…"
          }
        }
      }
    },
    "Import CSV…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV İçe Aktar…"
          }
        }
      }
    },
    "Delete History…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmişi Sil…"
          }
        }
      }
    },
    "Delete all recorded history?": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı tüm geçmiş silinsin mi?"
          }
        }
      }
    },
    "Delete Everything": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tümünü Sil"
          }
        }
      }
    },
    "Charge, power and health history will be removed permanently. Export a CSV first if you want a backup.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şarj, güç ve sağlık geçmişi kalıcı olarak silinecek. Yedek istiyorsanız önce CSV dışa aktarın."
          }
        }
      }
    },
    "Old samples are compacted automatically: raw power readings become hourly averages after 30 days. Daily health snapshots are kept forever.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eski örnekler otomatik olarak sıkıştırılır: ham güç okumaları 30 gün sonra saatlik ortalamalara dönüşür. Günlük sağlık anlık görüntüleri kalıcı olarak saklanır."
          }
        }
      }
    },
    "Check for updates automatically": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncellemeleri otomatik denetle"
          }
        }
      }
    },
    "Download updates automatically": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncellemeleri otomatik indir"
          }
        }
      }
    },
    "Version": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürüm"
          }
        }
      }
    },
    "Version %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürüm %@"
          }
        }
      }
    },
    "Check Now": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdi Denetle"
          }
        }
      }
    },
    "Check for Updates…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncellemeleri Denetle…"
          }
        }
      }
    },
    "Updates are the only network traffic Battistics ever makes. No analytics, no tracking, nothing else leaves this Mac.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncellemeler Battistics'in yaptığı tek ağ trafiğidir. Analitik yok, izleme yok, bu Mac'ten başka hiçbir şey çıkmaz."
          }
        }
      }
    },
    "Battery statistics for the Mac. Free and open source.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac için pil istatistikleri. Ücretsiz ve açık kaynak."
          }
        }
      }
    },
    "MIT License": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MIT Lisansı"
          }
        }
      }
    },
    "Runs entirely on this Mac. The only network request is the optional update check.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamamen bu Mac'te çalışır. Tek ağ isteği isteğe bağlı güncelleme denetimidir."
          }
        }
      }
    },
    "Charge history appears here as Battistics runs.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Battistics çalıştıkça şarj geçmişi burada görünür."
          }
        }
      }
    },
    "Battery Low": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pil Düşük"
          }
        }
      }
    },
