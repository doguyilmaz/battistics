    "Connected keyboards, mice, trackpads and headphones that report a battery level appear here. Some devices do not expose a level through the interfaces Battistics reads.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected keyboards, mice, trackpads and headphones that report a battery level appear here. Some devices do not expose a level through the interfaces Battistics reads."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pil seviyesini bildiren bağlı klavye, fare, trackpad ve kulaklıklar burada görünür. Bazı cihazlar, Battistics’in kullandığı arayüzler üzerinden pil seviyesi paylaşmaz."
          }
        }
      }
    },
