        }
      }
    },
    "Allowing closed-lid sessions sets up the power helper they need. A closed-lid session from iPhone always stops at 10% battery and under high thermal pressure.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowing closed-lid sessions sets up the power helper they need. A closed-lid session from iPhone always stops at 10% battery and under high thermal pressure."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapak kapalı oturumlara izin vermek, gereken güç yardımcısını kurar. iPhone’dan başlatılan kapak kapalı oturum, pil %10’a indiğinde ve yüksek ısı baskısında her zaman durur."
          }
        }
      }
    },
    "Allow…": {
      "extractionState": "manual",
