        }
      }
    },
    "Battery is fully charged. You can unplug the power adapter.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pil tamamen şarj oldu. Güç adaptörünü çıkarabilirsiniz."
