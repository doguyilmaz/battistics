          "stringUnit": {
            "state": "translated",
            "value": "Şarj %%%lld düzeyine düştü."
          }
        }
      }
    },
    "Battery is at %lld%%. Unplug now to reduce battery wear.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pil %%%lld düzeyinde. Pil yıpranmasını azaltmak için fişten çekin."
          }
        }
      }
    },
    "Battery is fully charged. You can unplug the power adapter.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pil tamamen şarj oldu. Güç adaptörünü çıkarabilirsiniz."
          }
        }
      }
    },
    "Battery temperature is %@.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pil sıcaklığı %@."
          }
        }
      }
    },
    "The Mac has been on battery power for %@.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac %@ süredir pil gücünde çalışıyor."
