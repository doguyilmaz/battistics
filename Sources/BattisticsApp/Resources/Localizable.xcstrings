            "state": "translated",
            "value": "Bitti"
          }
        }
      }
    },
    "Dots are daily readings, the line is a 7-day trend. The controller re-estimates capacity constantly, so single days swing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dots are daily readings, the line is a 7-day trend. The controller re-estimates capacity constantly, so single days swing."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Noktalar günlük okumaları, çizgi 7 günlük eğilimi gösterir. Denetleyici kapasiteyi sürekli yeniden hesapladığı için tek günler dalgalanır."
          }
        }
      }
    },
    "Download updates automatically": {
