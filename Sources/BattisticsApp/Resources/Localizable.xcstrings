        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pil Sağlığı Düştü"
          }
        }
      }
    },
    "Charge is at %lld%%. Connect power soon.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şarj %%%lld düzeyinde. En kısa sürede güç bağlayın."
          }
        }
      }
    },
    "Charge dropped to %lld%%.": {
      "localizations": {
