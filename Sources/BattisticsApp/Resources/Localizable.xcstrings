    "Battery is at %@. Connect power if the Mac must keep running.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pil %@ seviyesinde. Mac’in çalışmaya devam etmesi gerekiyorsa güce bağla."
          }
        }
      }
    },
    "Battery is at %lld%%. Keep Awake cannot prevent an empty battery from interrupting your work. Connect power soon.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pil %%%lld seviyesinde. Uyanık Tut, pil bittiğinde çalışmanızın kesilmesini önleyemez. Kısa süre içinde güç adaptörünü bağlayın."
          }
        }
      }
    },
    "Battery is at %lld%%. Keep Awake will stop at %lld%%. Connect power or save your work; with the lid closed, the Mac may sleep immediately.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pil %%%lld seviyesinde. Uyanık Tut %%%lld seviyesinde duracak. Güç adaptörünü bağlayın veya çalışmanızı kaydedin; kapak kapalıysa Mac hemen uyuyabilir."
          }
        }
      }
    },
    "Battery is at %lld%%. Unplug now to reduce battery wear.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pil %%%lld düzeyinde. Pil yıpranmasını azaltmak için fişten çekin."
          }
        }
      }
    },
    "Battery is fully charged. You can unplug the power adapter.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pil tamamen şarj oldu. Güç adaptörünü çıkarabilirsiniz."
