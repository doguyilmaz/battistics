    "100% CPU equals one logical core. Using several cores can exceed 100%.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "100% CPU equals one logical core. Using several cores can exceed 100%."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%100 CPU bir mantıksal çekirdeğe eşittir. Birden fazla çekirdek kullanan işlemler %100'ü aşabilir."
          }
        }
      }
    },
