          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilinmeyen cihaz"
          }
        }
      }
    },
    "Unsaved work in this app will be lost.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsaved work in this app will be lost."
          }
