    "Battistics": {
      "shouldTranslate": false
    },
    "Battistics %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Battistics %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Battistics %@"
          }
        }
      }
    },
    "Battistics holds a power assertion while this is on, the same mechanism the built-in caffeinate tool uses. It is released when you turn it off, when the timer runs out, or when Battistics quits.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Battistics holds a power assertion while this is on, the same mechanism the built-in caffeinate tool uses. It is released when you turn it off, when the timer runs out, or when Battistics quits."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu açıkken Battistics bir güç bildirimi tutar; yerleşik caffeinate aracının kullandığı mekanizmanın aynısı. Kapattığınızda, süre dolduğunda veya Battistics'ten çıktığınızda bırakılır."
          }
        }
      }
    },
    "Battistics needs a Mac with a built-in battery.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Battistics dahili pili olan bir Mac gerektirir."
          }
        }
      }
    },
    "Battistics quit unexpectedly %@": {
      "localizations": {
        "en": {
