    "Keep Awake ended because battery charge reached %lld%%. Normal sleep is allowed again. Connect power before starting another session.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pil şarjı %%%lld seviyesine ulaştığı için Uyanık Tut sonlandı. Normal uykuya yeniden izin veriliyor. Yeni bir oturum başlatmadan önce güç adaptörünü bağlayın."
          }
        }
      }
    },
    "Keep Awake ended because macOS reported high thermal pressure. Let the Mac cool before starting another session. Battistics does not change fan speeds.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS yüksek ısıl baskı bildirdiği için Uyanık Tut sonlandı. Yeni bir oturum başlatmadan önce Mac’in soğumasını bekleyin. Battistics fan hızlarını değiştirmez."
          }
        }
      }
    },
