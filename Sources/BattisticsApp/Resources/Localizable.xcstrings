    "Could not confirm restoring sleep. The helper will retry after its lease expires; repair the helper if sleep remains disabled.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not confirm restoring sleep. The helper will retry after its lease expires; repair the helper if sleep remains disabled."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyku ayarının geri yüklendiği doğrulanamadı. Yardımcı oturum süresi dolunca yeniden deneyecek; uyku devre dışı kalırsa yardımcıyı onarın."
          }
        }
      }
    },
    "macOS could not put the display to sleep.": {
      "extractionState": "manual",
