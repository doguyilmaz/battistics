    "An interactive AI terminal can stay open after work finishes. Use MCP to start a task before work and stop it afterward; process lifetime alone cannot detect AI task completion.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An interactive AI terminal can stay open after work finishes. Use MCP to start a task before work and stop it afterward; process lifetime alone cannot detect AI task completion."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkileşimli bir yapay zekâ terminali iş bittikten sonra açık kalabilir. MCP ile işe başlamadan önce görev başlatın ve iş bitince durdurun; yalnızca sürecin açık olması işin bitip bitmediğini göstermez."
          }
        }
      }
    },
    "An older helper is still running. Closed-lid Keep Awake needs the current one; Repair replaces it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An older helper is still running. Closed-lid Keep Awake needs the current one; Repair replaces it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eski bir yardımcı bileşen hâlâ çalışıyor. Kapak kapalı Uyanık Tut güncel sürümü gerektirir; Onar onu değiştirir."
          }
        }
      }
    },
    "An older power helper is still running. Restart the Mac to replace it, then try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An older power helper is still running. Restart the Mac to replace it, then try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eski bir güç yardımcısı hâlâ çalışıyor. Değiştirmek için Mac'i yeniden başlatın, ardından tekrar deneyin."
          }
        }
      }
    },
