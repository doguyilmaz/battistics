    },
    "Charge history appears here as Battistics runs.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Battistics çalıştıkça şarj geçmişi burada görünür."
          }
        }
      }
    },
    "Charge history records battery changes. Power and temperature history add periodic background readings; a longer interval reduces sampling work.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şarj geçmişi pil değişikliklerini kaydeder. Güç ve sıcaklık geçmişi arka planda düzenli ölçümler ekler; daha uzun aralık, ölçüm sıklığını azaltır."
          }
        }
      }
    },
    "Charge is at %lld%%. Connect power soon.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şarj %%%lld düzeyinde. En kısa sürede güç bağlayın."
          }
        }
      }
    },
    "Charge limit reached": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şarj limitine ulaşıldı"
          }
        }
      }
    },
    "Charge, power and health history will be removed permanently. Export a CSV first if you want a backup.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şarj, güç ve sağlık geçmişi kalıcı olarak silinecek. Yedek istiyorsanız önce CSV dışa aktarın."
          }
        }
      }
    },
