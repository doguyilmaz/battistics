{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "battistics-site",
  "compatibility_date": "2026-10-20",
  "assets": { "directory": "./dist", "not_found_handling": "404-page" },
  // Cloudflare creates the DNS record and certificate for this itself.
  "routes": [{ "pattern": "battistics.apps.doguyilmaz.com", "custom_domain": true }]
}
