---
const command = "brew install --cask doguyilmaz/tap/battistics";
---

<div class="brew">
  <code><span aria-hidden="true">$ </span>{command}</code>
  <button type="button" data-copy={command} aria-label="Copy the Homebrew command">Copy</button>
</div>

<style>
  .brew {
    display: flex;
    align-items: center;
    max-width: 100%;
    height: 52px;
    padding: 0 8px 0 16px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: color-mix(in oklab, var(--paper) 70%, transparent);
  }
  code {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    white-space: nowrap;
    padding: 6px 0;
    font: 13px/1.5 var(--mono);
    color: var(--ink-2);
    scrollbar-width: none;
  }
  code span { color: var(--ink-3); }
  button {
    flex: none;
    width: 74px;
    margin-left: 10px;
    height: 36px;
    padding: 0;
    border: 0;
    border-radius: 8px;
    font: 600 13px/1 var(--text);
    color: var(--ink);
    background: color-mix(in oklab, var(--ink) 8%, transparent);
    cursor: pointer;
  }
  button:focus-visible { outline: 2px solid var(--teal); outline-offset: 2px; }
</style>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? "");
        button.textContent = "Copied";
        setTimeout(() => (button.textContent = "Copy"), 1600);
      } catch {
        button.textContent = "⌘C";
      }
    });
  }
</script>
