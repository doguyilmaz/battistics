---
import { Image } from "astro:assets";
import bagReady from "../assets/shots/phone-dashboard.png";
import charging from "../assets/shots/phone-charging.png";
import liveActivity from "../assets/shots/live-activity.png";
import { symbolHTML } from "../lib/symbols";

const features = [
  { icon: "laptopcomputer", title: "The whole battery, anywhere", text: "Charge and its last day, time left, power, health and heat, plus the network the Mac is on and whether its lid is shut." },
  { icon: "cup.and.saucer.fill", title: "Keep Awake from your pocket", text: "Start any mode for any duration, lid closed included, and stop it again. Switch Low Power Mode or turn the display off." },
  { icon: "personalhotspot", title: "Ready for the bag", text: "Set the Mac to join your Hotspot and it stays online with the lid shut. Bag Ready tells you when it is safe to close it." },
  { icon: "lock.fill", title: "Lock Screen and Control Center", text: "A Live Activity counts down with buttons for 30 more minutes and Stop, next to widgets and a Control Center and Action Button control." },
  { icon: "bell.badge", title: "Alerts that matter", text: "Hear about it when a session ends, the battery runs low, the Mac stops answering or it reaches the charge you picked. They arrive at once, even with the app closed." },
  { icon: "icloud", title: "Through your own iCloud", text: "Every Mac on your Apple Account shows up by itself. Nothing to pair, no server, no account, and Siri knows the Mac too." },
];

const statusBar = `<span class="time">9:41</span><i class="island"></i><span class="icons">${symbolHTML("cellularbars", 10)}${symbolHTML("wifi", 10)}${symbolHTML("battery.100percent", 11)}</span>`;
---

<section class="remote" id="iphone" aria-labelledby="iphone-title">
  <div class="head">
    <div>
      <p class="soon"><Fragment set:html={symbolHTML("iphone", 14)} />Soon on the App Store</p>
      <h2 id="iphone-title">Your Mac, from your iPhone</h2>
    </div>
    <p class="lede">
      Battistics Remote finds every Mac on your Apple Account through your own iCloud and keeps working when the Mac is
      in a bag, lid closed, on your Hotspot.
    </p>
  </div>

  <div class="body">
    <ul class="features">
      {features.map((feature) => (
        <li>
          <span class="feature-icon" set:html={symbolHTML(feature.icon, 15)} />
          <div>
            <h3>{feature.title}</h3>
            <p>{feature.text}</p>
          </div>
        </li>
      ))}
      <li class="more-row"><a href="/docs/iphone/">How Battistics Remote works</a></li>
    </ul>

    <div class="devices">
      <div class="phone back" role="button" tabindex="0" data-zoom={charging.src} data-caption="A MacBook Pro charging, with its last day and Keep Awake ready to start." aria-label="Enlarge: MacBook Pro charging">
        <div class="screen">
          <div class="status" aria-hidden="true" set:html={statusBar} />
          <Image src={charging} alt="Battistics Remote showing a MacBook Pro charging, its last day and Keep Awake" widths={[300, 600]} sizes="250px" />
        </div>
      </div>
      <div class="phone front" role="button" tabindex="0" data-zoom={bagReady.src} data-caption="A MacBook Air kept awake with its lid closed, online through the iPhone's Hotspot: Bag Ready." aria-label="Enlarge: MacBook Air in Bag mode">
        <div class="screen">
          <div class="status" aria-hidden="true" set:html={statusBar} />
          <Image src={bagReady} alt="Battistics Remote showing a MacBook Air kept awake with the lid closed and Bag Ready" widths={[300, 600]} sizes="280px" />
        </div>
      </div>
      <div class="activity" role="button" tabindex="0" data-zoom={liveActivity.src} data-caption="The Live Activity on the Lock Screen: time left, the connection, 30 more minutes and Stop." aria-label="Enlarge: the Live Activity">
        <Image src={liveActivity} alt="The Lock Screen Live Activity: MacBook Air, lid closed, 1:04:43 remaining, with 30 min and Stop buttons" widths={[340, 680]} sizes="340px" />
      </div>
    </div>
  </div>
</section>

<style>
  .remote { max-width: var(--page); margin: 0 auto; padding: clamp(110px, 14vw, 170px) var(--gutter) 0; }
  .head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 20px 56px; align-items: end; }
  .soon {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 18px;
    padding: 7px 14px 7px 12px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.92rem;
    color: #fff;
    background: #111;
  }
  h2 {
    margin: 0;
    font: 720 clamp(2.3rem, 4.6vw, 3.6rem) / 1 var(--display);
    font-stretch: 86%;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .lede { margin: 0; max-width: 52ch; font-size: 1.08rem; line-height: 1.55; color: var(--ink-2); }

  .body { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 40px 56px; align-items: center; margin-top: 56px; }
  .features { display: grid; gap: 22px; margin: 0; padding: 0; list-style: none; }
  .features li { display: flex; gap: 12px; align-items: flex-start; }
  .feature-icon { display: grid; place-items: center; flex: none; width: 32px; height: 32px; border-radius: 10px; color: var(--ink); background: color-mix(in oklab, var(--accent-a) 28%, var(--paper)); }
  .features h3 { margin: 0; font-size: 1rem; }
  .features p { margin: 3px 0 0; color: var(--ink-2); line-height: 1.45; font-size: 0.95rem; text-wrap: pretty; }
  .more-row { padding-left: 44px; }
  .more-row a { font-weight: 600; }

  .devices { position: relative; height: 620px; }
  .phone {
    position: absolute;
    padding: 9px;
    border-radius: 50px;
    background: linear-gradient(150deg, #4a4e52, #17191a 35%, #23272a);
    box-shadow: inset 0 0 0 1px #6a6f73, inset 0 0 0 3px #101213, 0 40px 70px -30px rgb(10 30 20 / 0.55);
    cursor: zoom-in;
  }
  .phone.front { top: 10px; right: 6%; width: 280px; z-index: 2; }
  .phone.back { top: 60px; left: 4%; width: 240px; transform: rotate(-6deg); filter: brightness(0.92); }
  .screen { position: relative; overflow: hidden; border-radius: 41px; background: #000; aspect-ratio: 1170 / 2532; }
  .screen :global(img) { position: absolute; left: 0; bottom: 0; width: 100%; height: auto; }
  .status {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 5.13%;
    padding: 2% 9% 0 11%;
    color: #fff;
  }
  .status :global(.time) { font: 600 12.5px/1 var(--text); letter-spacing: -0.01em; }
  .status :global(.icons) { display: flex; align-items: center; gap: 4px; }
  .status :global(.island) { position: absolute; left: 50%; top: 26%; translate: -50% 0; width: 32%; height: 58%; border-radius: 999px; background: #000; }
  .activity {
    position: absolute;
    z-index: 3;
    left: 0;
    bottom: 24px;
    width: min(340px, 74%);
    border-radius: 20px;
    overflow: hidden;
    background: #121733;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.08), 0 30px 60px -20px rgb(10 20 40 / 0.55);
    cursor: zoom-in;
  }
  .activity :global(img) { display: block; width: 100%; height: auto; }
  .phone:focus-visible, .activity:focus-visible { outline: 3px solid var(--accent-b); outline-offset: 4px; }

  @media (max-width: 980px) {
    .head, .body { grid-template-columns: minmax(0, 1fr); }
    .devices { max-width: 520px; width: 100%; margin: 0 auto; }
  }
  @media (max-width: 560px) {
    .devices { height: 520px; }
    .phone.front { width: 230px; right: 2%; border-radius: 42px; padding: 8px; }
    .phone.back { width: 190px; left: 0; }
    .screen { border-radius: 34px; }
  }
</style>
