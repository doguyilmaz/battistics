---
import { Image } from "astro:assets";
import bagReady from "../assets/shots/phone-dashboard.png";
import charging from "../assets/shots/phone-charging.png";
import liveActivity from "../assets/shots/live-activity.png";

const features = [
  {
    title: "The whole battery, from across the room",
    text: "Charge and its last day, time left, power, health, heat, the connection and whether the lid is closed. Accessory batteries and the busiest apps on request.",
  },
  {
    title: "Keep Awake from your pocket",
    text: "Start any mode for any duration, lid closed included, and stop it again. Change the Mac's Low Power Mode or turn its display off.",
  },
  {
    title: "Ready for the bag",
    text: "A Mac set to join your iPhone's Personal Hotspot stays online with the lid shut. Battistics Remote says Bag Ready once it is, and warns before you close the lid on Wi‑Fi alone.",
  },
  {
    title: "Lock Screen, widgets and Control Center",
    text: "A Live Activity counts down with a Stop button. Home and Lock Screen widgets, and a Control Center and Action Button control, start or stop it.",
  },
  {
    title: "Siri and Shortcuts",
    text: "Keep Awake, Let Sleep, Check Mac, Mac Low Power and Display Off, by voice or in your own automations.",
  },
  {
    title: "Alerts that matter",
    text: "When a session ends, the battery runs low, the Mac stops answering or reaches the charge you picked.",
  },
];
---

<section class="remote" id="iphone" aria-labelledby="iphone-title">
  <div class="copy">
    <p class="soon">
      <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="4.4" y="1.5" width="7.2" height="13" rx="1.8" /><path d="M7 3.3h2" /></svg>
      Soon on the App Store
    </p>
    <h2 id="iphone-title">Your Mac, from your iPhone</h2>
    <p class="lede">
      Battistics Remote finds every Mac on your Apple Account through your own iCloud. Nothing to pair, no server in
      between, and it keeps working with the Mac in a bag.
    </p>
    <ul class="features">
      {features.map((feature) => (
        <li>
          <h3>{feature.title}</h3>
          <p>{feature.text}</p>
        </li>
      ))}
    </ul>
    <a class="more" href="/docs/iphone/">How Battistics Remote works</a>
  </div>

  <div class="devices">
    <div class="phone back" role="button" tabindex="0" data-zoom={charging.src} data-caption="A MacBook Pro charging, with its last day and Keep Awake ready to start." aria-label="Enlarge: MacBook Pro charging">
      <div class="screen">
        <div class="status" aria-hidden="true"><span>9:41</span><i class="island"></i><span class="icons"></span></div>
        <Image src={charging} alt="Battistics Remote showing a MacBook Pro charging, its last day and Keep Awake" widths={[300, 600]} sizes="260px" />
      </div>
    </div>
    <div class="phone front" role="button" tabindex="0" data-zoom={bagReady.src} data-caption="A MacBook Air kept awake with its lid closed, online through the iPhone's Hotspot: Bag Ready." aria-label="Enlarge: MacBook Air in Bag mode">
      <div class="screen">
        <div class="status" aria-hidden="true"><span>9:41</span><i class="island"></i><span class="icons"></span></div>
        <Image src={bagReady} alt="Battistics Remote showing a MacBook Air kept awake with the lid closed and Bag Ready" widths={[340, 680]} sizes="300px" />
      </div>
    </div>
    <div class="activity" role="button" tabindex="0" data-zoom={liveActivity.src} data-caption="The Live Activity on the Lock Screen: time left, the connection and a Stop button." aria-label="Enlarge: the Live Activity">
      <Image src={liveActivity} alt="The Lock Screen Live Activity: MacBook Air, lid closed, 1:00:16 remaining, with a Stop button" widths={[360, 720]} sizes="360px" />
    </div>
  </div>
</section>

<style>
  .remote {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 80px);
    align-items: start;
    max-width: var(--page);
    margin: 0 auto;
    padding: clamp(80px, 12vw, 140px) var(--gutter) 0;
  }
  .soon {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 20px;
    padding: 8px 14px 8px 11px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.93rem;
    color: #fff;
    background: #111;
  }
  .soon svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.3; stroke-linecap: round; }
  h2 {
    margin: 0;
    max-width: 13ch;
    font: 720 clamp(2.3rem, 4.6vw, 3.6rem) / 1 var(--display);
    font-stretch: 86%;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .lede { max-width: 52ch; margin: 20px 0 0; font-size: 1.1rem; line-height: 1.55; color: var(--ink-2); }
  .features { display: grid; gap: 22px; margin: 36px 0 0; padding: 0; list-style: none; }
  .features li { padding-left: 18px; border-left: 2px solid color-mix(in oklab, var(--accent-b) 55%, transparent); }
  .features h3 { margin: 0; font-size: 1.05rem; }
  .features p { margin: 4px 0 0; max-width: 56ch; color: var(--ink-2); line-height: 1.5; }
  .more { display: inline-block; margin-top: 28px; font-weight: 600; }

  .devices { position: sticky; top: 72px; height: 680px; }
  .phone {
    position: absolute;
    width: 300px;
    padding: 11px;
    border-radius: 54px;
    background: linear-gradient(145deg, #3b3f42, #121415 40%, #1d2022);
    box-shadow: inset 0 0 0 1.5px #55595c, 0 40px 80px -30px rgb(10 30 20 / 0.6);
    cursor: zoom-in;
  }
  .phone.front { top: 40px; left: 22%; z-index: 2; }
  .phone.back { top: 0; left: 0; width: 260px; transform: rotate(-5deg); filter: saturate(0.9) brightness(0.92); }
  .screen { position: relative; overflow: hidden; border-radius: 44px; background: #000; aspect-ratio: 1170 / 2532; }
  .screen :global(img) { position: absolute; left: 0; bottom: 0; width: 100%; height: auto; }
  .status {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 5.13%;
    padding: 0 10% 0 12%;
    color: #fff;
    font: 600 13px/1 var(--text);
  }
  .island { position: absolute; left: 50%; top: 22%; translate: -50% 0; width: 31%; height: 62%; border-radius: 999px; background: #000; }
  .icons { width: 42px; height: 10px; background:
    linear-gradient(#fff, #fff) right center / 20px 9px no-repeat,
    radial-gradient(circle at 50% 100%, #fff 0 3px, transparent 3.5px) 6px center / 14px 10px no-repeat; border-radius: 2px; opacity: 0.95; }
  .activity {
    position: absolute;
    z-index: 3;
    left: 0;
    bottom: 10px;
    width: min(360px, 78%);
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 30px 60px -20px rgb(10 20 40 / 0.6);
    cursor: zoom-in;
  }
  .activity :global(img) { display: block; width: 100%; height: auto; }
  .phone:focus-visible, .activity:focus-visible { outline: 3px solid var(--accent-b); outline-offset: 4px; }

  @media (max-width: 960px) {
    .remote { grid-template-columns: minmax(0, 1fr); }
    .devices { position: relative; top: 0; height: 640px; max-width: 520px; margin: 0 auto; width: 100%; }
  }
  @media (max-width: 520px) {
    .devices { height: 560px; }
    .phone { width: 240px; border-radius: 44px; padding: 9px; }
    .screen { border-radius: 36px; }
    .phone.back { width: 200px; }
    .phone.front { left: 26%; }
  }
</style>
