---
import { symbolHTML } from "../lib/symbols";

const durations = [
  [15, "15m"], [30, "30m"], [60, "1h"], [120, "2h"], [240, "4h"], [720, "12h"], [0, "∞"],
] as const;

const modes = [
  { id: "displayOn", name: "Display on", line: "For a talk, a dashboard or a recipe.", same: "caffeinate -d" },
  { id: "displayMaySleep", name: "Display may sleep", line: "Builds, downloads and AI tasks keep going.", same: "caffeinate -i" },
  { id: "lidClosed", name: "Lid closed", line: "Shut it, bag it, it keeps running.", same: "caffeinate -i + disablesleep" },
];

const guards = [
  { icon: "battery.25percent", title: "Stops before the battery runs out", text: "At 5 to 50%, after a warning. It ends the session, never the Mac." },
  { icon: "thermometer.medium", title: "Stops when it runs hot", text: "Heavy thermal pressure warns you and can end it. Bags trap heat." },
  { icon: "arrow.uturn.backward.circle", title: "Always gives sleep back", text: "On the timer, on a stop, or 45 seconds after Battistics quits." },
];
---

<section class="night" id="awake" aria-labelledby="awake-title">
  <div class="inner">
    <div class="head">
      <h2 id="awake-title">Keep it awake. Lid open or closed.</h2>
      <div>
        <p>
          Three modes, 15 minutes to 12 hours or until you stop it, from the menu bar, a profile, the terminal, an AI
          client or your iPhone. Start one here and watch the menu bar above.
        </p>
        <p class="free-line">No trial, no subscription, no Pro version. It is free, like the rest of Battistics.</p>
      </div>
    </div>

    <div class="durations" role="radiogroup" aria-label="Duration">
      <span>Run for</span>
      {durations.map(([minutes, label]) => (
        <button type="button" role="radio" aria-checked={minutes === 60 ? "true" : "false"} data-ka-duration={minutes}>{label}</button>
      ))}
    </div>

    <div class="modes">
      {modes.map((mode) => (
        <article class="mode" data-ka-mode={mode.id}>
          <div class="art" aria-hidden="true">
            {mode.id === "displayOn" && (
              <svg viewBox="0 0 160 96">
                <defs><linearGradient id="lit" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="var(--accent-a)" /><stop offset="1" stop-color="var(--accent-b)" /></linearGradient></defs>
                <ellipse cx="80" cy="84" rx="66" ry="8" class="glow" />
                <rect x="34" y="8" width="92" height="62" rx="6" class="lid" />
                <rect x="39" y="13" width="82" height="52" rx="2" fill="url(#lit)" class="screen-on" />
                <path d="M48 27h36M48 36h54M48 45h26" class="ui-lines" />
                <path d="M22 72h116l-8 8H30z" class="base" />
              </svg>
            )}
            {mode.id === "displayMaySleep" && (
              <svg viewBox="0 0 160 96">
                <rect x="34" y="8" width="92" height="62" rx="6" class="lid" />
                <rect x="39" y="13" width="82" height="52" rx="2" class="screen-off" />
                <text x="90" y="36" class="zz">z</text><text x="99" y="29" class="zz small">z</text>
                <g class="activity"><circle cx="68" cy="48" r="2.6" /><circle cx="78" cy="48" r="2.6" /><circle cx="88" cy="48" r="2.6" /></g>
                <path d="M22 72h116l-8 8H30z" class="base" />
              </svg>
            )}
            {mode.id === "lidClosed" && (
              <svg viewBox="0 0 160 96">
                <path d="M62 26c0-12 36-12 36 0" class="strap" />
                <rect x="28" y="26" width="104" height="62" rx="13" class="bag" />
                <rect x="44" y="45" width="72" height="8" rx="4" class="closed" />
                <g class="waves"><path d="M114 14a9 9 0 0 1 13 0" /><path d="M110 9a15 15 0 0 1 21 0" /><circle cx="120.5" cy="18" r="1.8" /></g>
                <path d="M50 70h60" class="seam" />
              </svg>
            )}
          </div>
          <div class="text">
            <h3>{mode.name}</h3>
            <p>{mode.line}</p>
          </div>
          <div class="foot">
            <code>{mode.same}</code>
            <button type="button" class="start" data-ka-start={mode.id} aria-label={`Start ${mode.name}`}>
              <span data-ka-label>Start</span>
            </button>
          </div>
        </article>
      ))}
    </div>

    <ul class="guards">
      {guards.map((guard) => (
        <li>
          <h3><span class="guard-icon" set:html={symbolHTML(guard.icon, 16)} />{guard.title}</h3>
          <p>{guard.text}</p>
        </li>
      ))}
    </ul>

    <div class="table-wrap">
      <table>
        <caption>The three modes side by side</caption>
        <thead>
          <tr><th scope="col"></th><th scope="col">Display on</th><th scope="col">Display may sleep</th><th scope="col" class="hl">Lid closed</th></tr>
        </thead>
        <tbody>
          <tr><th scope="row">Display</th><td>Stays lit</td><td>Sleeps on its timer</td><td class="hl">Off while shut</td></tr>
          <tr><th scope="row">Closing the lid</th><td>Mac sleeps</td><td>Mac sleeps</td><td class="hl">Mac keeps running</td></tr>
          <tr><th scope="row">Screen locks</th><td>When you lock it</td><td>When the display sleeps</td><td class="hl">When the lid closes</td></tr>
          <tr><th scope="row">Apple menu › Sleep</th><td>Works</td><td>Works</td><td class="hl">Waits for the session</td></tr>
          <tr><th scope="row">Battery use</th><td>Highest</td><td>Low</td><td class="hl">Low, watch the heat</td></tr>
          <tr><th scope="row">Setup</th><td>None</td><td>None</td><td class="hl">A helper, approved once</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .night {
    --n-ink: #e9efea;
    --n-ink-2: #a9b8b0;
    --n-line: rgb(255 255 255 / 0.1);
    position: relative;
    z-index: 0;
    isolation: isolate;
    margin-top: clamp(80px, 12vw, 140px);
    padding: clamp(64px, 8vw, 96px) var(--gutter);
    color: var(--n-ink);
    background: #0d1311;
  }
  /* Glows sit across the section's edges, so the colour carries on into the
     light sections instead of stopping at a hard line. */
  .night::before,
  .night::after {
    content: "";
    position: absolute;
    z-index: -1;
    pointer-events: none;
    border-radius: 50%;
    filter: blur(60px);
  }
  .night::before {
    top: -180px;
    right: -6%;
    width: 52%;
    height: 420px;
    background: radial-gradient(closest-side, color-mix(in oklab, var(--accent-b) 38%, transparent), transparent);
  }
  .night::after {
    bottom: -200px;
    left: -8%;
    width: 46%;
    height: 420px;
    background: radial-gradient(closest-side, color-mix(in oklab, var(--accent-a) 26%, transparent), transparent);
  }
  .inner { max-width: var(--page); margin: 0 auto; }
  .head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 20px 56px; align-items: end; }
  h2 {
    margin: 0;
    max-width: 14ch;
    font: 720 clamp(2.4rem, 5vw, 4rem) / 0.98 var(--display);
    font-stretch: 86%;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .head p { margin: 0; max-width: 54ch; font-size: 1.06rem; line-height: 1.55; color: var(--n-ink-2); }
  .head .free-line { margin-top: 12px; color: var(--n-ink); font-weight: 600; }

  .durations { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-top: 40px; }
  .durations span { margin-right: 6px; color: var(--n-ink-2); }
  .durations button {
    min-width: 46px;
    height: 34px;
    padding: 0 12px;
    border: 1px solid var(--n-line);
    border-radius: 999px;
    font: 600 14px var(--text);
    color: var(--n-ink);
    background: rgb(255 255 255 / 0.04);
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }
  .durations button[aria-checked="true"] { background: var(--n-ink); color: #0d1311; border-color: transparent; }
  .durations button:focus-visible, .start:focus-visible { outline: 2px solid var(--accent-a); outline-offset: 2px; }

  .modes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin-top: 16px; }
  .mode {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr);
    grid-template-rows: auto auto;
    gap: 4px 16px;
    align-items: center;
    padding: 16px;
    border-radius: 18px;
    border: 1px solid var(--n-line);
    background: rgb(255 255 255 / 0.035);
    transition: border-color 0.25s, background 0.25s;
  }
  .mode[data-running="true"] { border-color: color-mix(in oklab, var(--accent-a) 70%, transparent); background: rgb(255 255 255 / 0.07); }
  .art { grid-row: 1 / span 2; }
  .art svg { display: block; width: 112px; height: 68px; overflow: visible; }
  .lid { fill: #2a3330; stroke: #4a5752; }
  .screen-off { fill: #0a0f0d; }
  .base { fill: #3a4541; }
  .ui-lines { stroke: rgb(13 30 24 / 0.55); stroke-width: 4; stroke-linecap: round; }
  .glow { fill: color-mix(in oklab, var(--accent-b) 40%, transparent); filter: blur(8px); }
  .zz { fill: var(--n-ink-2); font: 700 12px var(--text); }
  .zz.small { font-size: 8px; }
  .activity circle { fill: var(--accent-a); }
  .bag { fill: #26302c; stroke: #55635d; stroke-width: 1.5; }
  .strap { fill: none; stroke: #55635d; stroke-width: 5; stroke-linecap: round; }
  .closed { fill: #4a5752; }
  .seam { stroke: #3a4541; stroke-width: 2; stroke-dasharray: 3 4; }
  .waves path { fill: none; stroke: var(--accent-a); stroke-width: 2; stroke-linecap: round; }
  .waves circle { fill: var(--accent-a); }
  @media (prefers-reduced-motion: no-preference) {
    .mode[data-running="true"] .activity circle { animation: pulse 1.2s ease-in-out infinite; }
    .mode[data-running="true"] .activity circle:nth-child(2) { animation-delay: 0.2s; }
    .mode[data-running="true"] .activity circle:nth-child(3) { animation-delay: 0.4s; }
    .mode[data-running="true"] .waves path { animation: pulse 1.6s ease-in-out infinite; }
    .mode[data-running="true"] .waves path:nth-child(2) { animation-delay: 0.3s; }
    .mode[data-running="true"] .screen-on { animation: breathe 3s ease-in-out infinite; }
  }
  @keyframes pulse { 50% { opacity: 0.25; } }
  @keyframes breathe { 50% { opacity: 0.8; } }
  .text h3 { margin: 0; font: 700 1.15rem/1.15 var(--display); font-stretch: 92%; }
  .text p { margin: 4px 0 0; font-size: 0.93rem; line-height: 1.4; color: var(--n-ink-2); }
  .foot { grid-column: 1 / -1; display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-top: 12px; }
  .foot code { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding: 4px 8px; border-radius: 6px; font: 11.5px var(--mono); color: var(--n-ink-2); background: rgb(255 255 255 / 0.06); }
  .start {
    flex: none;
    min-width: 92px;
    height: 34px;
    padding: 0 14px;
    border: 0;
    border-radius: 10px;
    font: 600 14px var(--text);
    color: #0d1311;
    background: var(--charge);
    cursor: pointer;
    font-variant-numeric: tabular-nums;
  }
  .mode[data-running="true"] .start { color: var(--n-ink); background: rgb(255 255 255 / 0.12); }

  .guards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px 32px; margin: 44px 0 0; padding: 32px 0 0; list-style: none; border-top: 1px solid var(--n-line); }
  .guards h3 { display: flex; align-items: center; gap: 10px; margin: 0; font-size: 1rem; }
  .guard-icon { display: grid; place-items: center; flex: none; width: 30px; height: 30px; border-radius: 9px; color: var(--accent-a); background: rgb(255 255 255 / 0.07); }
  .guards p { margin: 8px 0 0 40px; color: var(--n-ink-2); line-height: 1.5; font-size: 0.95rem; }

  .table-wrap { margin-top: 44px; overflow-x: auto; }
  table { width: 100%; min-width: 600px; border-collapse: separate; border-spacing: 0; font-size: 0.95rem; }
  caption { text-align: left; padding-bottom: 14px; font: 700 1.15rem var(--display); font-stretch: 92%; }
  th, td { padding: 12px 14px; text-align: left; border-bottom: 1px solid var(--n-line); }
  thead th { font-weight: 650; }
  tbody th { color: var(--n-ink-2); font-weight: 500; white-space: nowrap; }
  .hl { background: color-mix(in oklab, var(--accent-b) 14%, transparent); color: var(--n-ink); }
  thead .hl { background: var(--charge); color: #0d1311; border-radius: 10px 10px 0 0; border-bottom-color: transparent; }
  tbody tr:last-child .hl { border-radius: 0 0 10px 10px; }

  @media (max-width: 980px) {
    .head, .modes, .guards { grid-template-columns: minmax(0, 1fr); }
  }
</style>

<script>
  import { remainingSeconds, startSession, stopSession, subscribe, type AwakeMode } from "../lib/sim";

  const root = document.getElementById("awake")!;
  let minutes = 60;
  for (const button of root.querySelectorAll<HTMLButtonElement>("[data-ka-duration]")) {
    button.addEventListener("click", () => {
      minutes = Number(button.dataset.kaDuration);
      for (const other of root.querySelectorAll("[data-ka-duration]")) other.setAttribute("aria-checked", String(other === button));
    });
  }
  let running: AwakeMode | null = null;
  for (const button of root.querySelectorAll<HTMLButtonElement>("[data-ka-start]")) {
    button.addEventListener("click", () => {
      const mode = button.dataset.kaStart as AwakeMode;
      if (running === mode) stopSession();
      else startSession(mode, minutes);
    });
  }
  let ticker: number | undefined;
  subscribe((s) => {
    running = s.session?.mode ?? null;
    clearInterval(ticker);
    for (const card of root.querySelectorAll<HTMLElement>("[data-ka-mode]")) {
      const active = card.dataset.kaMode === running;
      card.dataset.running = String(active);
      const label = card.querySelector<HTMLElement>("[data-ka-label]")!;
      if (!active || !s.session) {
        label.textContent = "Start";
        continue;
      }
      const session = s.session;
      const draw = () => {
        const left = remainingSeconds(session);
        if (left === 0) return stopSession();
        if (left === null) return (label.textContent = "Stop");
        const h = Math.floor(left / 3600);
        const m = Math.floor((left % 3600) / 60);
        const sec = String(left % 60).padStart(2, "0");
        label.textContent = `${h ? `${h}:${String(m).padStart(2, "0")}` : m}:${sec} · Stop`;
      };
      draw();
      ticker = window.setInterval(draw, 1000);
    }
  });
</script>
