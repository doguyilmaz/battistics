---
import { GLYPH_SHAPES, glyphSVG, glyphTone } from "../lib/glyph";

const start = 64;
---

<div class="lab" data-lab>
  <ul class="glyphs">
    {
      GLYPH_SHAPES.map(({ shape, label }) => (
        <li>
          <div class="plate" data-shape={shape} data-tone={glyphTone(start / 100, false)}>
            <Fragment set:html={glyphSVG({ shape, fraction: start / 100, charging: false })} />
          </div>
          <span>{label}</span>
        </li>
      ))
    }
  </ul>
  <div class="controls">
    <label class="slider">
      <span>Charge</span>
      <input type="range" min="0" max="100" value={start} data-level aria-describedby="lab-note" />
      <output data-level-out>{start}%</output>
    </label>
    <label class="toggle">
      <input type="checkbox" data-charging />
      <span>Charging</span>
    </label>
  </div>
  <p id="lab-note" class="note">
    Orange at 20% and red at 10% by default, and blue while charging and green when full if you turn them on. The
    percentage can sit next to the icon or inside it.
  </p>
</div>

<style>
  .lab { margin-top: 40px; }
  .glyphs {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(8px, 2vw, 20px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li { text-align: center; color: var(--ink-2); font-size: 0.92rem; }
  .plate {
    display: grid;
    place-items: center;
    aspect-ratio: 1.45;
    margin-bottom: 10px;
    border-radius: 16px;
    border: 1px solid var(--line);
    background: color-mix(in oklab, var(--paper-2) 70%, transparent);
    color: var(--ink);
    transition: color 0.2s ease;
  }
  .plate :global(svg) { width: 62%; height: auto; overflow: visible; }
  .plate[data-tone="low"] { color: var(--sys-orange); }
  .plate[data-tone="critical"] { color: var(--sys-red); }
  .plate[data-tone="charging"] { color: var(--sys-blue); }
  .plate[data-tone="full"] { color: var(--sys-green); }

  .controls { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 32px; margin-top: 28px; }
  .slider { display: flex; align-items: center; gap: 14px; flex: 1 1 320px; font-weight: 600; }
  .slider input { flex: 1; accent-color: var(--teal); height: 28px; }
  output { min-width: 4ch; text-align: right; font-variant-numeric: tabular-nums; }
  .toggle { display: inline-flex; align-items: center; gap: 10px; font-weight: 600; cursor: pointer; }
  .toggle input { width: 18px; height: 18px; accent-color: var(--teal); }
  .note { max-width: var(--measure); margin: 18px 0 0; color: var(--ink-2); }

  @media (max-width: 560px) {
    .glyphs { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>

<script>
  import { glyphSVG, glyphTone, type GlyphShape } from "../lib/glyph";

  const lab = document.querySelector("[data-lab]");
  const level = lab?.querySelector<HTMLInputElement>("[data-level]");
  const charging = lab?.querySelector<HTMLInputElement>("[data-charging]");
  const out = lab?.querySelector("[data-level-out]");
  const plates = lab?.querySelectorAll<HTMLElement>(".plate") ?? [];

  function draw() {
    if (!level || !charging) return;
    const fraction = Number(level.value) / 100;
    if (out) out.textContent = `${level.value}%`;
    for (const plate of plates) {
      const shape = plate.dataset.shape as GlyphShape;
      plate.dataset.tone = glyphTone(fraction, charging.checked);
      plate.innerHTML = glyphSVG({ shape, fraction, charging: charging.checked });
    }
  }
  level?.addEventListener("input", draw);
  charging?.addEventListener("change", draw);
</script>
