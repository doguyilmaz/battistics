---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { symbolHTML } from "../lib/symbols";

interface Props {
  src: ImageMetadata;
  alt: string;
}

const { src, alt } = Astro.props;
const image = await getImage({ src, width: 600, format: "webp" });
const statusHeight = 130;
const height = src.height + statusHeight;
---

<div class="screen" style={`--status-height: ${statusHeight / height * 100}%`}>
  <svg class="screen-image" viewBox={`0 0 ${src.width} ${height}`} width={src.width} height={height} role="img" aria-label={alt}>
    <!-- Stretch the same decoded image's first row behind the status icons.
         Overlap the body slightly so rotation cannot expose the black backing. -->
    <svg width={src.width} height={statusHeight + 2} viewBox={`0 0 ${src.width} 1`} preserveAspectRatio="none" overflow="hidden" aria-hidden="true">
      <image href={image.src} width={src.width} height={src.height} preserveAspectRatio="none" />
    </svg>
    <image href={image.src} y={statusHeight} width={src.width} height={src.height} preserveAspectRatio="none" />
  </svg>
  <div class="status" aria-hidden="true">
    <span class="time">9:41</span>
    <i class="island"></i>
    <span class="icons"><Fragment set:html={symbolHTML("cellularbars", 10) + symbolHTML("wifi", 10) + symbolHTML("battery.100percent", 11)} /></span>
  </div>
</div>

<style>
  .screen { position: relative; overflow: hidden; border-radius: 41px; background: #000; }
  .screen-image { display: block; width: 100%; height: auto; }
  .status {
    position: absolute;
    inset: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--status-height);
    padding: 2% 9% 0 11%;
    color: #fff;
  }
  .time { font: 600 12.5px/1 var(--text); letter-spacing: -0.01em; }
  .icons { display: flex; align-items: center; gap: 4px; }
  .island { position: absolute; left: 50%; top: 26%; translate: -50% 0; width: 32%; height: 58%; border-radius: 999px; background: #000; }
  @media (max-width: 560px) { .screen { border-radius: 34px; } }
</style>
