---
const pillars = [
  {
    title: "No account. No analytics.",
    text: "There is nothing to sign up for and nothing counting what you do. No tracking and no telemetry.",
    icon: '<circle cx="12" cy="8" r="3.5"/><path d="M5 20c.8-3.6 3.6-5.5 7-5.5s6.2 1.9 7 5.5"/><path d="M3 3l18 18"/>',
  },
  {
    title: "One network request: updates",
    text: "The only network traffic Battistics starts is the update check. Your battery history stays in a file on your Mac.",
    icon: '<path d="M12 3v12m0 0-4-4m4 4 4-4"/><path d="M4 17v2.5A1.5 1.5 0 0 0 5.5 21h13a1.5 1.5 0 0 0 1.5-1.5V17"/>',
  },
  {
    title: "Your iPhone, through your iCloud",
    text: "Sharing with Battistics Remote is off until you turn it on. Then it goes through your private iCloud database, encrypted, with no port opened on the Mac.",
    icon: '<path d="M7 18a4 4 0 0 1-.6-7.96A6 6 0 0 1 18 9a4.5 4.5 0 0 1-.5 9z"/><rect x="9.5" y="11.5" width="5" height="4" rx="1"/><path d="M10.5 11.5v-1a1.5 1.5 0 0 1 3 0v1"/>',
  },
];
---

<section class="privacy" id="privacy" aria-labelledby="privacy-title">
  <div class="inner">
    <h2 id="privacy-title">What happens on your Mac stays on your Mac.</h2>
    <p class="lede">
      A battery app sees when you work, when you sleep and where you charge. Battistics keeps all of it to itself, and
      the source is open so you can check.
    </p>
    <div class="pillars">
      {pillars.map((pillar) => (
        <article>
          <svg viewBox="0 0 24 24" aria-hidden="true" set:html={pillar.icon} />
          <h3>{pillar.title}</h3>
          <p>{pillar.text}</p>
        </article>
      ))}
    </div>
    <a class="source" href="https://github.com/doguyilmaz/battistics">Read the source on GitHub</a>
  </div>
</section>

<style>
  .privacy { padding: clamp(80px, 12vw, 140px) var(--gutter) 0; }
  .inner {
    max-width: var(--page);
    margin: 0 auto;
    padding: clamp(40px, 6vw, 72px);
    border-radius: 32px;
    background:
      linear-gradient(180deg, color-mix(in oklab, var(--accent-a) 10%, transparent), transparent 60%),
      var(--paper-2);
    border: 1px solid var(--line);
  }
  h2 {
    margin: 0;
    max-width: 16ch;
    font: 720 clamp(2.2rem, 4.8vw, 3.8rem) / 1 var(--display);
    font-stretch: 86%;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .lede { max-width: 58ch; margin: 20px 0 0; font-size: 1.1rem; line-height: 1.55; color: var(--ink-2); }
  .pillars { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; margin-top: 44px; }
  .pillars svg {
    width: 34px;
    height: 34px;
    padding: 7px;
    border-radius: 10px;
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    background: color-mix(in oklab, var(--accent-a) 30%, var(--paper));
    box-sizing: content-box;
  }
  .pillars h3 { margin: 16px 0 6px; font-size: 1.1rem; }
  .pillars p { margin: 0; color: var(--ink-2); line-height: 1.55; }
  .source { display: inline-block; margin-top: 36px; font-weight: 600; }
  @media (max-width: 860px) {
    .pillars { grid-template-columns: minmax(0, 1fr); gap: 24px; }
  }
</style>
