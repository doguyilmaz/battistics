---
// A handwritten hint with an arrow that draws itself the first time it
// scrolls into view.
interface Props {
  text: string;
  /** The shaft, in the arrow's own viewBox. */
  path: string;
  /** The arrowhead at the shaft's end. */
  head: string;
  width: number;
  height: number;
  class?: string;
}
const { text, path, head, width, height, class: className } = Astro.props;
---

<div class:list={["scribble", className]} data-scribble aria-hidden="true">
  <p>{text}</p>
  <svg viewBox={`0 0 ${width} ${height}`} width={width} height={height}>
    <path class="shaft" d={path} pathLength="1" />
    <path class="head" d={head} pathLength="1" />
  </svg>
</div>

<style>
  .scribble {
    --hand: color-mix(in oklab, var(--accent-b) 72%, var(--ink));
    position: absolute;
    z-index: 2;
    pointer-events: none;
    color: var(--hand);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .scribble { --hand: var(--accent-a); }
  }
  :global(:root[data-theme="dark"]) .scribble { --hand: var(--accent-a); }
  p {
    margin: 0;
    font: 400 1.45rem/1.05 "Gochi Hand", var(--text);
    rotate: -4deg;
    opacity: 0;
    translate: 0 6px;
    transition: opacity 0.45s ease, translate 0.45s ease;
  }
  svg { display: block; overflow: visible; }
  path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .scribble[data-drawn] p { opacity: 1; translate: 0 0; }
  .scribble[data-drawn] .shaft { transition: stroke-dashoffset 0.9s cubic-bezier(0.6, 0, 0.3, 1) 0.25s; stroke-dashoffset: 0; }
  .scribble[data-drawn] .head { transition: stroke-dashoffset 0.25s ease-out 1.1s; stroke-dashoffset: 0; }
  .scribble[data-drawn] svg { animation: nudge 3.2s ease-in-out 2s infinite; }
  @keyframes nudge {
    0%, 70%, 100% { translate: 0 0; }
    80% { translate: 3px 3px; }
    90% { translate: 0 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    p, path { transition: none !important; }
    .scribble[data-drawn] svg { animation: none; }
  }
</style>

<script>
  const seen = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        (entry.target as HTMLElement).dataset.drawn = "";
        seen.unobserve(entry.target);
      }
    },
    { threshold: 1 },
  );
  for (const hint of document.querySelectorAll<HTMLElement>("[data-scribble]")) {
    seen.observe(hint);
  }
</script>
