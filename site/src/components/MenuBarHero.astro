---
import MenuBar from "./MenuBar.astro";
import Popover from "./Popover.astro";
import DownloadButton from "./DownloadButton.astro";
import BrewCommand from "./BrewCommand.astro";

// Contour lines of the app's Wings glyph, nested like a topographic map.
const wing = (s: number, cx: number, cy: number) => {
  const p = (x: number, y: number) => `${(cx + (x - 0.5) * s).toFixed(1)} ${(cy - (y - 0.5) * s * 0.58).toFixed(1)}`;
  const c = (a: number[], b: number[], e: number[]) => `C${p(a[0], a[1])} ${p(b[0], b[1])} ${p(e[0], e[1])}`;
  return (
    `M${p(0.03, 0.6)}` +
    c([0.13, 0.86], [0.28, 0.84], [0.4, 0.8]) + c([0.41, 0.86], [0.41, 0.93], [0.43, 0.97]) +
    c([0.46, 0.92], [0.48, 0.86], [0.5, 0.84]) + c([0.52, 0.86], [0.54, 0.92], [0.57, 0.97]) +
    c([0.59, 0.93], [0.59, 0.86], [0.6, 0.8]) + c([0.72, 0.84], [0.87, 0.86], [0.97, 0.6]) +
    c([0.88, 0.44], [0.8, 0.36], [0.7, 0.36]) + c([0.64, 0.36], [0.6, 0.3], [0.56, 0.24]) +
    c([0.53, 0.18], [0.51, 0.1], [0.5, 0.06]) + c([0.49, 0.1], [0.47, 0.18], [0.44, 0.24]) +
    c([0.4, 0.3], [0.36, 0.36], [0.3, 0.36]) + c([0.2, 0.36], [0.12, 0.44], [0.03, 0.6]) + "Z"
  );
};
const contours = Array.from({ length: 9 }, (_, i) => wing(520 + i * 210, 1060, 470));
---

<header class="desk" aria-labelledby="hero-title">
  <svg class="lines" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <defs>
      <linearGradient id="contour" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="var(--accent-a)" /><stop offset="1" stop-color="var(--accent-b)" />
      </linearGradient>
    </defs>
    {contours.map((d, i) => <path d={d} style={`opacity:${(0.55 - i * 0.05).toFixed(2)}`} />)}
  </svg>

  <MenuBar />

  <div class="hero">
    <div class="pitch">
      <p class="free">Free for every Mac. Open source.</p>
      <h1 id="hero-title">Your Mac’s battery, read properly.</h1>
      <p class="lede">
        Battistics lives in the menu bar and shows what macOS knows about the battery: charge, health, cycles,
        temperature and every watt going in or out. When the Mac has to stay up, it keeps it awake, even with the lid
        closed in a bag.
      </p>
      <div class="actions">
        <DownloadButton />
        <BrewCommand />
      </div>
      <p class="fineprint">macOS 14 or later, Apple Silicon. Try the menu bar above: it works.</p>
    </div>
  </div>

  <Popover />
</header>

<style>
  .desk {
    position: relative;
    overflow: clip;
    padding-bottom: clamp(56px, 8vw, 104px);
    background:
      radial-gradient(80% 60% at 75% 40%, color-mix(in oklab, var(--accent-b) 12%, transparent), transparent 70%),
      var(--paper);
  }
  .lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .lines path { fill: none; stroke: url(#contour); stroke-width: 1.2; vector-effect: non-scaling-stroke; }

  .hero {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: clamp(32px, 6vw, 88px);
    min-height: 700px;
    max-width: var(--page);
    margin: 0 auto;
    padding: clamp(56px, 9vw, 120px) var(--gutter) 0;
  }
  .pitch { min-width: 0; }
  .free {
    display: inline-block;
    margin: 0 0 22px;
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--ink);
    background: color-mix(in oklab, var(--accent-a) 22%, var(--paper));
    border: 1px solid color-mix(in oklab, var(--accent-b) 35%, transparent);
  }
  h1 {
    margin: 0;
    max-width: 12ch;
    font: 720 clamp(2.9rem, 6.6vw, 5.4rem) / 0.96 var(--display);
    font-stretch: 86%;
    letter-spacing: -0.022em;
    text-wrap: balance;
  }
  .lede { max-width: 50ch; margin: 28px 0 0; font-size: 1.16rem; line-height: 1.56; color: var(--ink-2); }
  .actions { display: grid; grid-template-columns: minmax(0, 1fr); gap: 10px; width: min(100%, 500px); margin-top: 36px; }
  .fineprint { margin: 16px 0 0; font-size: 0.92rem; color: var(--ink-3); }

  @media (max-width: 900px) {
    .hero { grid-template-columns: minmax(0, 1fr); min-height: 0; }
    .desk :global(.pop) { position: relative; top: auto; right: auto; margin: 48px auto 0; width: min(340px, calc(100% - 2 * var(--gutter))); }
    .desk :global(.pop .arrow) { display: none; }
  }
</style>

<script>
  // Hang the popover under the status item, as macOS does.
  const desk = document.querySelector<HTMLElement>(".desk")!;
  const pop = document.getElementById("popover")!;
  const place = () => {
    const item = document.querySelector<HTMLElement>("[data-status-item]");
    if (!item || matchMedia("(max-width: 900px)").matches) return;
    const box = item.getBoundingClientRect();
    const deskBox = desk.getBoundingClientRect();
    const center = box.left + box.width / 2 - deskBox.left;
    const right = Math.max(12, Math.min(deskBox.width - center - 90, deskBox.width - 352));
    desk.style.setProperty("--pop-right", `${right}px`);
    pop.style.setProperty("--arrow-right", `${deskBox.width - right - center - 7}px`);
  };
  place();
  addEventListener("resize", place);
  document.fonts?.ready.then(place);
  document.addEventListener("place-popover", place);
  document.addEventListener("open-popover", () => {
    place();
    if (scrollY > 240) scrollTo({ top: 0, behavior: "smooth" });
  });
</script>
