---
import { Image } from "astro:assets";
import Page from "../layouts/Page.astro";
import MenuBarHero from "../components/MenuBarHero.astro";
import GlyphLab from "../components/GlyphLab.astro";
import DownloadButton from "../components/DownloadButton.astro";
import BrewCommand from "../components/BrewCommand.astro";
import overview from "../assets/shots/overview.png";
import power from "../assets/shots/system.png";
import history from "../assets/shots/history.png";
import phoneDashboard from "../assets/shots/phone-dashboard.png";
import phoneCharging from "../assets/shots/phone-charging.png";
import icon from "../assets/icon.png";

const readings = [
  ["Health", "Today's full charge against the design capacity, both as macOS reports it and as measured."],
  ["Cycles", "How many full charges the battery has been through, next to the count it was designed for."],
  ["Power", "Watts in from the adapter, used by the Mac and drawn from the battery, live."],
  ["Temperature", "The battery's own sensor, and an alert when it runs hot."],
  ["Accessories", "Keyboards, mice, trackpads and AirPods that report a battery."],
  ["Busiest apps", "Which apps are using the most energy, measured only while you look."],
];
---

<Page
  title="Battistics: battery statistics for the Mac"
  description="A free, open source menu bar app that shows your Mac's battery health, cycles, power and history, and keeps the Mac awake when you need it, lid closed included."
>
  <MenuBarHero />

  <main>
    <section class="band" aria-labelledby="readings">
      <div class="split">
        <div class="copy">
          <h2 id="readings">Everything the battery reports, in one window</h2>
          <p>
            macOS tracks far more about the battery than the menu bar shows. Battistics reads it from the hardware every
            time the power state changes and lays it out in plain words.
          </p>
        </div>
        <Image src={overview} alt="The Battistics Overview window: charge, health and cycle rings above capacity and live readings" widths={[640, 972]} sizes="(max-width: 860px) 100vw, 640px" class="shot" />
      </div>
      <dl class="readings">
        {readings.map(([term, detail]) => (
          <div><dt>{term}</dt><dd>{detail}</dd></div>
        ))}
      </dl>
    </section>

    <section class="band" aria-labelledby="menubar">
      <h2 id="menubar">An icon that reads like a gauge</h2>
      <p class="intro">
        Five icon styles, all drawn live at the battery's real level. Drag the charge to see how each one reports it.
      </p>
      <GlyphLab />
    </section>

    <section class="band" aria-labelledby="awake">
      <div class="split reverse">
        <div class="copy">
          <h2 id="awake">Keep it awake, lid open or closed</h2>
          <p>
            Pick a mode and a duration from 15 minutes to 12 hours, or until you turn it off. Ready-made profiles cover a
            long build, an AI task, a presentation or a night of downloads.
          </p>
          <p>
            Closed-lid mode borrows macOS's sleep setting through a small helper you approve once, and always gives it
            back: on the timer, on a battery or heat stop, and within 45 seconds if Battistics quits or crashes.
          </p>
        </div>
        <Image src={power} alt="The Power pane with Keep Awake mode, duration and the ready-made profiles" widths={[640, 972]} sizes="(max-width: 860px) 100vw, 640px" class="shot" />
      </div>

      <div class="table-wrap">
        <table>
          <caption>The three Keep Awake modes</caption>
          <thead>
            <tr><th scope="col"></th><th scope="col">Display on</th><th scope="col">Display may sleep</th><th scope="col">Lid closed</th></tr>
          </thead>
          <tbody>
            <tr><th scope="row">Display</th><td>Stays lit</td><td>Sleeps on its timer</td><td>Sleeps on its timer</td></tr>
            <tr><th scope="row">Closing the lid</th><td>Mac sleeps</td><td>Mac sleeps</td><td>Mac keeps running</td></tr>
            <tr><th scope="row">Battery use</th><td>Highest</td><td>Low</td><td>Low, but a bag traps heat</td></tr>
            <tr><th scope="row">Setup</th><td>None</td><td>None</td><td>Helper, approved once</td></tr>
            <tr><th scope="row">Same as</th><td><code>caffeinate -d</code></td><td><code>caffeinate -i</code></td><td><code>caffeinate -i</code> + <code>pmset disablesleep 1</code></td></tr>
          </tbody>
        </table>
      </div>

      <ul class="guards">
        <li><strong>Stops at a battery level.</strong> Pick anywhere from 5 to 50%. It ends the session and never shuts the Mac down.</li>
        <li><strong>Stops under heat.</strong> Heavy thermal pressure warns you and can end the session. Fan speeds are left alone.</li>
        <li><strong>Warns before it stops.</strong> A low-battery warning and an optional one when the adapter is pulled.</li>
      </ul>
    </section>

    <section class="band" aria-labelledby="history">
      <div class="split">
        <div class="copy">
          <h2 id="history">A year of charge, power, heat and health</h2>
          <p>
            Charts by day, week, month and year, with how long the Mac spent on battery, charging and full. The history
            lives in a database on your Mac, and you can export it to CSV or bring an old one back.
          </p>
          <p>Notifications cover low battery, a full charge, your charge limit, high temperature and a drop in health.</p>
        </div>
        <Image src={history} alt="The History window showing a day of charge with time on battery, charging and fully charged" widths={[640, 972]} sizes="(max-width: 860px) 100vw, 640px" class="shot" />
      </div>
    </section>

    <section class="band phone" aria-labelledby="iphone">
      <div class="split reverse">
        <div class="copy">
          <h2 id="iphone">Your Mac, from your iPhone</h2>
          <p>
            Battistics Remote shows the Mac's battery and its last day, how long it will last, its connection, lid and
            heat, and starts or stops Keep Awake, even with the lid closed in a bag.
          </p>
          <p>
            Widgets, a Lock Screen countdown, a Control Center control and Siri shortcuts come with it. It finds your Mac
            through your own iCloud, with nothing to pair and no server in between.
          </p>
          <p class="soon">Battistics Remote is not on the App Store yet.</p>
        </div>
        <div class="phones">
          <Image src={phoneDashboard} alt="Battistics Remote on iPhone showing a MacBook's battery and Keep Awake controls" widths={[300, 600]} sizes="300px" class="phone-shot" />
          <Image src={phoneCharging} alt="Battistics Remote showing a MacBook Pro charging, with its last day and Keep Awake controls" widths={[300, 600]} sizes="300px" class="phone-shot" />
        </div>
      </div>
    </section>

    <section class="band" aria-labelledby="developers">
      <h2 id="developers">For long builds and AI tasks</h2>
      <p class="intro">
        Turn on Local automation and Keep Awake follows your work: as long as a command runs, or from start to stop of an
        AI task through the bundled MCP server. Nothing leaves the Mac.
      </p>
      <div class="code-pair">
        <figure>
          <figcaption>In a terminal</figcaption>
          <pre><code><span class="prompt">$</span> battistics run --name Build -- swift build</code></pre>
        </figure>
        <figure>
          <figcaption>In an MCP client</figcaption>
          <pre><code>{`{"mcpServers": {"battistics": {
  "command": "/Applications/Battistics.app/Contents/MacOS/battistics-mcp"
}}}`}</code></pre>
        </figure>
      </div>
      <p class="more"><a href="/docs/automation/terminal/">Terminal</a> and <a href="/docs/automation/mcp/">MCP</a> guides</p>
    </section>

    <section class="band privacy" aria-labelledby="privacy">
      <h2 id="privacy">Stays on your Mac</h2>
      <ul>
        <li>No account, no analytics, no tracking.</li>
        <li>The only network request is the optional update check.</li>
        <li>iPhone sharing is off until you turn it on, and then goes through your private, encrypted iCloud.</li>
      </ul>
    </section>

    <section class="get" id="download" aria-labelledby="get">
      <Image src={icon} alt="" width={112} height={112} class="icon" />
      <h2 id="get">Get Battistics</h2>
      <p>Free and open source under the MIT license. macOS 14 or later on Apple Silicon. Updates arrive in the app.</p>
      <div class="actions">
        <DownloadButton large />
        <BrewCommand />
      </div>
    </section>
  </main>

  <footer>
    <nav aria-label="More">
      <a href="/docs/">Documentation</a>
      <a href="https://github.com/doguyilmaz/battistics">Source on GitHub</a>
      <a href="https://github.com/doguyilmaz/battistics/blob/main/CHANGELOG.md">What's new</a>
      <a href="https://github.com/doguyilmaz/battistics/issues">Report a problem</a>
    </nav>
    <p>Made by <a href="https://doguyilmaz.com">Dogu Yilmaz</a>.</p>
  </footer>
</Page>

<style>
  main { max-width: var(--page); margin: 0 auto; padding: 0 var(--gutter); }
  .band { padding: clamp(64px, 10vw, 128px) 0 0; }
  h2 {
    margin: 0;
    max-width: 18ch;
    font: 700 clamp(2rem, 4vw, 3.1rem) / 1 var(--display);
    font-stretch: 80%;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  p { max-width: var(--measure); }
  .copy p, .intro { margin: 20px 0 0; color: var(--ink-2); font-size: 1.06rem; }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
  }
  .split.reverse > .copy { order: 2; }
  .shot { width: 100%; height: auto; margin: -2% -3%; max-width: 106%; }

  .readings {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px 40px;
    margin: 48px 0 0;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }
  .readings dt { font: 700 1.2rem/1.2 var(--display); font-stretch: 85%; }
  .readings dd { margin: 6px 0 0; color: var(--ink-2); font-size: 0.97rem; }

  .table-wrap { margin-top: 56px; overflow-x: auto; }
  table { width: 100%; min-width: 620px; border-collapse: collapse; font-size: 0.97rem; }
  caption { text-align: left; padding-bottom: 14px; font: 700 1.2rem/1.2 var(--display); font-stretch: 85%; }
  th, td { padding: 13px 14px; text-align: left; vertical-align: top; border-bottom: 1px solid var(--line); }
  thead th { font-weight: 650; border-bottom: 2px solid var(--ink); }
  thead th:last-child { background: var(--charge); color: #10201a; border-radius: 10px 10px 0 0; }
  tbody th { font-weight: 600; color: var(--ink-2); white-space: nowrap; }
  tbody td:last-child { background: color-mix(in oklab, var(--teal) 7%, transparent); }
  code { font: 0.86em var(--mono); }

  .guards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px 40px;
    margin: 40px 0 0;
    padding: 0;
    list-style: none;
    color: var(--ink-2);
  }
  .guards strong { display: block; margin-bottom: 4px; color: var(--ink); }

  .phones { display: flex; justify-content: center; gap: clamp(12px, 3vw, 28px); }
  .phone-shot { width: min(46%, 260px); height: auto; border-radius: 36px; box-shadow: 0 0 0 7px #1b1f1d, 0 30px 60px -24px rgb(10 30 20 / 0.45); }
  .phone-shot:nth-child(2) { margin-top: 56px; }
  .soon { color: var(--ink-3) !important; font-size: 0.95rem !important; }

  .code-pair { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 20px; margin-top: 36px; }
  .code-pair figure { margin: 0; }
  .code-pair figcaption { margin-bottom: 8px; font-weight: 600; color: var(--ink-2); font-size: 0.92rem; }
  pre {
    margin: 0;
    padding: 18px 20px;
    overflow-x: auto;
    border-radius: 14px;
    background: #17201c;
    color: #dfe8e2;
    font: 13.5px/1.6 var(--mono);
  }
  pre code { font: inherit; }
  .prompt { color: var(--lime); }
  .more { margin: 18px 0 0; }

  .privacy ul { display: grid; gap: 10px; margin: 24px 0 0; padding: 0; list-style: none; font-size: 1.1rem; }
  .privacy li { display: flex; gap: 12px; align-items: baseline; }
  .privacy li::before { content: ""; flex: none; width: 10px; height: 10px; border-radius: 3px; background: var(--charge); translate: 0 -1px; }

  .get {
    margin-top: clamp(80px, 12vw, 140px);
    padding: clamp(48px, 8vw, 88px) var(--gutter);
    border-radius: 28px;
    text-align: center;
    background: #16201b;
    color: #e8efe9;
    --ink: #e8efe9;
    --paper: #16201b;
    --line: #2c3833;
    --ink-2: #b2c0b8;
    --ink-3: #8a988f;
  }
  .get h2 { margin: 18px auto 0; max-width: none; }
  .get p { margin: 16px auto 0; color: var(--ink-2); }
  .get .actions { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; margin-top: 32px; }
  .icon { width: 112px; height: 112px; }
  .get :global(.download) { background: var(--charge); color: #10201a; }
  .get :global(.download small) { background: rgb(16 32 26 / 0.85); color: #e8efe9; }

  footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    max-width: var(--page);
    margin: 0 auto;
    padding: 40px var(--gutter) 56px;
    color: var(--ink-3);
    font-size: 0.93rem;
  }
  footer nav { display: flex; flex-wrap: wrap; gap: 8px 24px; }
  footer a { color: var(--ink-2); }
  footer p { margin: 0; }

  @media (max-width: 860px) {
    .split { grid-template-columns: 1fr; }
    .split.reverse > .copy { order: 0; }
    .readings, .guards { grid-template-columns: 1fr 1fr; }
    .code-pair { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .readings, .guards { grid-template-columns: 1fr; }
  }
</style>
